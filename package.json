{
  "name": "beerapp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/",
    "backlog": "node scripts/backlog/create-backlog.ts",
    "prepare": "lefthook install",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:lint": "supabase db lint --schema public --level warning --fail-on warning",
    "db:types": "supabase gen types typescript > app/src/types/database.ts && prettier --write --log-level warn app/src/types/database.ts",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10"
  }
}
