# Copia aquest fitxer a .env.local (no es puja al repo).
# Local: valors de `supabase start` (claus de demo, iguals per a tothom).
# Al mòbil físic, canvia 127.0.0.1 per la IP del Mac a la xarxa local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Google Sign-In (optional; the button is hidden until these exist). From Google Cloud → OAuth clients.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=yyy.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.yyy

# Sign in with Apple (iOS). Set to true once the Apple Developer account and the Supabase Apple provider exist.
# EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=true
